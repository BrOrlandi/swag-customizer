# Local development only. Never commit .env.
# For the public deployment, visitors provide their own keys in the UI.
NUXT_ALLOW_ENV_KEYS=false
NUXT_OPENAI_API_KEY=
NUXT_GEMINI_API_KEY=

# Backend: public HTTPS URL used in file URLs; never append a trailing slash.
NUXT_PUBLIC_URL=http://localhost:3000
NUXT_PUBLIC_API_BASE=
NUXT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100
NUXT_STORAGE_DIR=.data/files
NUXT_STORAGE_MAX_BYTES=10737418240
NUXT_OPENAI_CHAT_MODEL=gpt-4o
# Optional compatible chat provider. Private server setting; no default endpoint.
NUXT_NINE_ROUTER_BASE_URL=
NUXT_NINE_ROUTER_CHAT_MODEL=cx/gpt-6.1-sol
NUXT_OPENAI_IMAGE_MODEL=gpt-image-1.5
NUXT_GEMINI_IMAGE_MODEL=gemini-3-pro-image

# Optional email. Both must be set; otherwise no email is sent.
NUXT_RESEND_API_KEY=
NUXT_EMAIL_FROM=
