{
  "framework": null,
  "buildCommand": "npm run generate:site",
  "outputDirectory": ".output/site",
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/((?!_nuxt/|images/|data/|favicon).*)",
      "destination": "/app/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/demo/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/edit",
      "destination": "/app/edit",
      "permanent": true
    },
    {
      "source": "/quote/:path*",
      "destination": "/app/quote/:path*",
      "permanent": true
    }
  ]
}
